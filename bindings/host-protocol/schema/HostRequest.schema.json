{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostRequest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "client": {
          "type": "string"
        },
        "client_protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "method": {
          "type": "string",
          "const": "handshake"
        }
      },
      "required": [
        "method",
        "client",
        "client_protocol"
      ]
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "health"
        }
      },
      "required": [
        "method"
      ]
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "shutdown"
        }
      },
      "required": [
        "method"
      ]
    }
  ],
  "required": [
    "v",
    "id"
  ]
}
