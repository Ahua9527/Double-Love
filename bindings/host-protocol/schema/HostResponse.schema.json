{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/HostResult"
        },
        "status": {
          "type": "string",
          "const": "ok"
        }
      },
      "required": [
        "status",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/HostProtocolError"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "required": [
    "v",
    "id"
  ],
  "$defs": {
    "HostHello": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_version": {
          "type": "string"
        },
        "host_version": {
          "type": "string"
        },
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol",
        "host_version",
        "engine_version",
        "capabilities"
      ]
    },
    "HostProtocolError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "HostResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/HostHello"
            },
            "type": {
              "type": "string",
              "const": "hello"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "healthy": {
                  "type": "boolean"
                }
              },
              "required": [
                "healthy"
              ]
            },
            "type": {
              "type": "string",
              "const": "health"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "shutdown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}
