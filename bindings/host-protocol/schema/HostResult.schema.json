{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/HostHello"
        },
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "healthy": {
              "type": "boolean"
            }
          },
          "required": [
            "healthy"
          ]
        },
        "type": {
          "type": "string",
          "const": "health"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "shutdown"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": true,
        "type": {
          "type": "string",
          "const": "invoke"
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "HostHello": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_version": {
          "type": "string"
        },
        "host_version": {
          "type": "string"
        },
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol",
        "host_version",
        "engine_version",
        "capabilities"
      ]
    }
  }
}
