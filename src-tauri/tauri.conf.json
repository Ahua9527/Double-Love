{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Double Love Studio",
  "version": "0.1.0",
  "identifier": "space.ahua.doublelove.studio",
  "build": {
    "beforeDevCommand": "pnpm studio:dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm studio:build",
    "frontendDist": "../studio/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Double Love Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["resources/runtime/*", "resources/model-runtime/**/*"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
